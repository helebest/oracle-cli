# --- gateway auth ---
# Leave blank — gateway auto-generates one on first start and writes it
# into data/config/openclaw.json. Set explicitly only if you want a known token.
OPENCLAW_GATEWAY_TOKEN=

# --- LLM provider ---
# Currently using ChatGPT Plus / Codex subscription via OAuth — no API key
# needed. Auth handled by `openclaw onboard --auth-choice openai-codex`
# (or `--device-code` for headless), credentials stored in OpenClaw's own
# agent auth store under data/config/. Model: openai-codex/gpt-5.5.
#
# Uncomment below only if switching to raw API-key auth instead:
# OPENAI_API_KEY=
# OPENAI_API_KEYS=sk-1,sk-2     # optional: rotate across multiple keys
# CODEX_API_KEY=                # local-stdio fallback for native Codex

# --- Telegram ---
TELEGRAM_BOT_TOKEN=

# --- Feishu / 飞书 (currently unused; uncomment if re-enabling) ---
# FEISHU_APP_ID=
# FEISHU_APP_SECRET=
# FEISHU_VERIFICATION_TOKEN=
# FEISHU_ENCRYPT_KEY=
